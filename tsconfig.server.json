{
	"compilerOptions": {
		"erasableSyntaxOnly": true,
		"lib": ["ES2023"],
		"module": "ESNext",
		"moduleDetection": "force",
		"moduleResolution": "Bundler",
		"noEmit": true,
		"noFallthroughCasesInSwitch": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"skipLibCheck": true,
		"target": "ES2023",
		"types": ["@citizenfx/server", "node"],
		"verbatimModuleSyntax": true
	},
	"include": ["server"]
}
